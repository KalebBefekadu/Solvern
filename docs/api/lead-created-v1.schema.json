{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvern.com/schemas/lead-created-v1.schema.json",
  "title": "Solvern lead.created event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventType", "eventId", "occurredAt", "lead"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventType": { "const": "lead.created" },
    "eventId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "tradeSlug",
        "tradeName",
        "name",
        "phone",
        "email",
        "zip",
        "message",
        "preferredContact",
        "existingJob",
        "jobNumber",
        "topic",
        "sourceUrl",
        "attribution",
        "photoCount",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["concept_preview", "visit", "callback"] },
        "tradeSlug": { "type": ["string", "null"] },
        "tradeName": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "zip": { "type": "string" },
        "message": { "type": "string" },
        "preferredContact": { "type": ["string", "null"] },
        "existingJob": { "type": "boolean" },
        "jobNumber": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"] },
        "sourceUrl": { "type": "string" },
        "attribution": { "type": "object", "additionalProperties": { "type": "string" } },
        "photoCount": { "type": "integer", "minimum": 0 },
        "status": { "const": "new" }
      }
    }
  }
}
