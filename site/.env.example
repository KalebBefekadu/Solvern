# Copy to .env.local for local development. Every value is optional in development:
# without Supabase, leads and uploads are written to ./.data; without Resend, emails are logged.

# Public site URL (open item: solvern.com or solvernhome.com)
NEXT_PUBLIC_SITE_URL=https://solvern.com

# Supabase (server only; never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=lead-uploads

# Resend (transactional email)
RESEND_API_KEY=
LEAD_NOTIFY_TO=            # team inbox, comma separated
LEAD_NOTIFY_FROM=          # e.g. Solvern Home <hello@solvern.com>, must be a verified sender

# Cloudflare Turnstile (spam protection). Leave both empty to disable in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
