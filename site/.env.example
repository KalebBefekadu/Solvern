# Copy to .env.local for local development. Every value is optional in development:
# without Supabase, leads and uploads are written to ./.data; without Resend, emails are logged.

# Public site URL (open item: solvern.com or solvernhome.com)
NEXT_PUBLIC_SITE_URL=https://solvern.com

# Supabase (server only; never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=lead-uploads
RATE_LIMIT_SECRET=          # at least 32 random characters; server only; keep stable across instances

# Resend (transactional email)
RESEND_API_KEY=
LEAD_NOTIFY_TO=            # team inbox, comma separated
LEAD_NOTIFY_FROM=          # e.g. Solvern Home <hello@solvern.com>, must be a verified sender

# Cloudflare Turnstile (spam protection). Leave both empty to disable in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional lead-management platform connector. Every new lead is POSTed as a
# versioned event with an HMAC SHA-256 signature in X-Solvern-Signature.
LEAD_PLATFORM_WEBHOOK_URL=
LEAD_PLATFORM_WEBHOOK_SECRET=

# Required for durable lead delivery in production. A private scheduler calls
# /api/lead-delivery/worker every minute. CRON_SECRET can be used instead.
OUTBOX_WORKER_SECRET=

# Optional staff-reviewed Concept Preview generation. Keep the flag false until
# migration 0006, a private worker scheduler, and a review inbox are ready.
PREVIEW_GENERATION_ENABLED=false
OPENAI_API_KEY=
PREVIEW_WORKER_SECRET=
