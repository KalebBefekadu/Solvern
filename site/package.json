{
  "name": "solvern-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:brand": "node scripts/check-brand.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run check:brand && npm run check:colors && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "15.5.27",
    "perfect-freehand": "^1.2.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "culori": "^4.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
